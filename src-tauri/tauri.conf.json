{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "rtl-viewer",
  "version": "0.1.0",
  "identifier": "com.natsume.rtl-viewer",
  "build": {
    "frontendDist": "../dist",
    "devUrl": "http://localhost:1420",
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build"
  },
  "app": {
    "windows": [
      {
        "title": "rtl-viewer",
        "width": 1280,
        "height": 800
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "icon": []
  }
}
